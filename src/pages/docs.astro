                  <p class="text-[40px] leading-none font-semibold tracking-[-0.04em]">{integrations.filter((x) => x.effort === e).length}</p>
                  <p class={`mt-3 text-[12.5px] ${e === 'Keskitaso' ? 'text-white/60' : 'text-muted'}`}>{e === 'Valmis' ? 'Toimii sellaisenaan' : e === 'Helppo' ? 'Pieni työ' : e === 'Keskitaso' ? 'Vaatii oman ratkaisun' : 'Ei tarvita enää'}</p>
