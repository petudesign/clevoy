---
/**
 * /docs – brand kit, design system, architecture and migration plan in one page.
 * Doubles as raw material for the case study. All data lives in src/data/*.
 * Only the live demos are islands; everything else is static HTML.
 */
import Base from '../layouts/Base.astro'
import { Logo, WindowMark, WindowMarkSoft, ClevoyMark } from '../components/Logo'
import { LogoColorways, LogoDirections } from '../components/BrandSheets'
import { RotatingWord } from '../components/RotatingWord'
import { PhoneDemo } from '../components/PhoneDemo'
import { colors, typeScale, radii, motion } from '../data/tokens'
import { decisions } from '../data/decisions'
import lh from '../data/lighthouse.json'
import { integrations } from '../data/integrations'
import SectionHead from '../components/docs/SectionHead.astro'
import Rule from '../components/docs/Rule.astro'
import Faq from '../components/docs/Faq.astro'
import CtaButton from '../components/CtaButton.astro'
import { ArrowSwap } from '../components/ArrowSwap'
import {
  ArrowRight,
  ArrowUpRight,
  House,
  Truck,
  Key,
  Briefcase,
  Buildings,
  CalendarCheck,
  Star,
  ShieldCheck,
} from '@phosphor-icons/react'

const sec = (ms: number) => (ms / 1000).toLocaleString('fi-FI', { maximumFractionDigits: 1 })
const toc = [
  ['brandi', 'Brändi'],
  ['design-system', 'Design system'],
  ['liike', 'Liike'],
  ['arkkitehtuuri', 'Arkkitehtuuri'],
  ['mittaukset', 'Mittaukset'],
  ['seo', 'SEO ja GEO'],
  ['integraatiot', 'Integraatiot'],
  ['siirtyma', 'CMS ja siirtymä'],
  ['paatokset', 'Päätösloki'],
]
const stats = [
  { label: 'Lighthouse, suorituskyky', before: `${lh.current.scores.performance}`, after: `${lh.next.scores.performance}`, unit: '/100' },
  { label: 'Suurin sisältö näkyvissä (LCP)', before: sec(lh.current.lcp), after: sec(lh.next.lcp), unit: 's' },
  { label: 'JavaScript', before: `${lh.current.jsKB}`, after: `${lh.next.jsKB}`, unit: 'kt' },
  { label: 'Pyyntöjä sivulatauksessa', before: `${lh.current.requests}`, after: `${lh.next.requests}`, unit: '' },
]
const grouped = Object.entries(
  colors.reduce<Record<string, typeof colors>>((a, c) => ((a[c.group] ??= []).push(c), a), {}),
)
---

<Base title="Clevoy · Uudistuksen docs" description="Brändi, design system, arkkitehtuuri ja siirtymäsuunnitelma.">
  <div class="overflow-x-clip pb-24">
    <!-- ───────── Cover ───────── -->
    <header class="px-3 pt-3 md:px-4 md:pt-4">
      <div class="reveal relative overflow-hidden rounded-[2rem] bg-ink text-white md:rounded-[2.5rem]">
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_60%_at_85%_0%,rgba(184,103,159,0.35),transparent_70%),radial-gradient(50%_50%_at_0%_100%,rgba(199,212,234,0.12),transparent_70%)]"
        >
        </div>
        <div class="relative mx-auto max-w-[1240px] px-5 pt-6 pb-10 md:px-10 md:pt-8 md:pb-14">
          <div class="flex items-center justify-between gap-4">
            <Logo variant="ikkuna" size={20} tone="dark" />
            <span class="rounded-full border border-white/15 px-3 py-1.5 font-mono text-[11px] text-white/60">
              v0.2 · 19.11.2026
            </span>
          </div>

          <div class="mt-16 grid grid-cols-1 gap-10 md:mt-24 lg:grid-cols-[1.4fr_1fr] lg:items-end">
            <div>
              <p class="mb-5 text-[13px] text-white/60">Konseptiehdotus</p>
              <h1 class="text-[40px] leading-[1.02] font-semibold tracking-[-0.035em] sm:text-[56px] lg:text-[76px]">
                Sama palvelu.<br />
                <span class="text-plum-light">Uusi ilme</span> ja nopeampi pohja.
              </h1>
            </div>
            <p class="max-w-[44ch] text-[16px] leading-relaxed text-white/65">
              Tässä on koko uudistus yhdellä sivulla: logo ja värit, design system, liikkeen periaatteet, uusi
              tekninen pohja mittauksineen ja suunnitelma, jolla siirtymä nykyisestä WordPressistä tehdään
              ilman katkoja.
            </p>
          </div>

          <div class="mt-12 grid grid-cols-2 gap-2 md:mt-16 lg:grid-cols-4">
            {
              stats.map((s, i) => (
                <div class={`rounded-[1.5rem] p-5 md:p-6 ${i === 0 ? 'bg-[#f6f1f4] text-ink' : 'bg-white/[0.06] text-white'}`}>
                  <p class="flex items-baseline gap-2">
                    <span class={`font-mono text-[14px] line-through ${i === 0 ? 'text-muted' : 'text-white/40'}`}>{s.before}</span>
                    <ArrowRight size={12} className="opacity-40" />
                  </p>
                  <p class="mt-1 text-[38px] leading-none font-semibold tracking-[-0.04em] md:text-[48px]">
                    {s.after}
                    <span class={`ml-1 text-[16px] font-medium tracking-normal ${i === 0 ? 'text-muted' : 'text-white/50'}`}>{s.unit}</span>
                  </p>
                  <p class={`mt-4 text-[12.5px] ${i === 0 ? 'text-ink-soft' : 'text-white/55'}`}>{s.label}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-4 text-[12px] text-white/40">
            Lighthouse {lh.current.lighthouse}, mobiiliprofiili, mediaani {lh.current.runs} ajosta. Ehdot ja varaukset
            kohdassa <a href="#mittaukset" class="underline underline-offset-2 hover:text-white/70">Mittaukset</a>.
          </p>
        </div>
      </div>
    </header>

    <div class="mx-auto grid max-w-[1240px] grid-cols-1 gap-10 px-4 pt-14 md:px-8 lg:grid-cols-[180px_1fr] lg:gap-14 lg:pt-20">
      <!-- ───────── TOC ───────── -->
      <nav aria-label="Sisällys" class="hidden lg:block">
        <ol class="sticky top-8 flex flex-col gap-1 text-[13.5px]">
          {
            toc.map(([id, label], i) => (
              <li>
                <a href={`#${id}`} class="flex gap-3 rounded-lg px-2 py-1.5 text-ink-soft transition-colors hover:bg-ink/[0.04] hover:text-ink">
                  <span class="font-mono text-[11px] text-muted">0{i + 1}</span>
                  {label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <main class="flex min-w-0 flex-col gap-24 md:gap-32">
        <!-- ───────── 01 Brändi ───────── -->
        <section id="brandi" class="scroll-mt-8">
          <SectionHead n="01" title="Brändi" accent="Ikkuna, joka kertoo palvelun">
            Merkki on kaari-ikkuna. Se viittaa kotiin ja juuri pestyyn ikkunaan, ja yksi valaistu ruutu muistuttaa
            varattua aikaa kalenterissa. Moppi ja sanko jäivät pois, samoin geneerinen startup-abstraktio.
          </SectionHead>

          <div class="grid grid-cols-1 gap-3 md:grid-cols-[1.35fr_1fr]">
            <div class="relative grid min-h-[320px] place-items-center overflow-hidden rounded-[2rem] bg-plum-soft p-10">
              <Logo variant="ikkuna" size={64} />
              <span class="absolute bottom-5 left-6 font-mono text-[11px] text-plum">Päälogo · tummalla vaalealle</span>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div class="grid aspect-square place-items-center rounded-[2rem] bg-ink">
                <ClevoyMark size={72} tone="dark" />
              </div>
              <div class="grid aspect-square place-items-center rounded-[2rem] bg-plum">
                <WindowMarkSoft size={72} ink="#ffffff" accent="#ecc6dc" />
              </div>
              <div class="col-span-2 flex items-center justify-between gap-4 rounded-[2rem] border border-line bg-white p-6">
                <div>
                  <p class="text-[14px] font-semibold">Sovellusikoni ja favicon</p>
                  <p class="text-[12.5px] text-muted">Sama muoto kaikissa koissa, hehku vain yli 24 px</p>
                </div>
                <div class="flex items-center gap-3">
                  <span class="grid size-14 place-items-center rounded-[16px] bg-ink shadow-[0_10px_20px_-10px_rgba(21,23,28,0.6)]">
                    <ClevoyMark size={30} tone="dark" />
                  </span>
                  <WindowMark size={24} />
                  <WindowMark size={16} />
                </div>
              </div>
            </div>
          </div>

          <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-3">
            <Rule title="Suoja-alue" text="Logon ympärille jätetään vähintään merkin leveyden verran tyhjää." />
            <Rule title="Koot" text="Muoto on kaikissa koissa sama pyöristetty ikkuna. Yli 24 px mukana ovat valogradientti ja luumuruudun hehku, 24 px ja alle merkki on yksivärinen, jotta se pysyy terävänä. Minimikoko 16 px." />
            <Rule title="Kohdistus" text="Merkin alareuna asettuu tekstin peruslinjalle. Laatikoiden keskitys ei riitä, koska merkki on kirjaimia korkeampi." />
          </div>

          <h3 class="mt-16 mb-2 text-[20px] font-semibold tracking-tight">Värivaihtoehdot</h3>
          <p class="mb-6 max-w-[62ch] text-[14.5px] leading-relaxed text-muted">
            Ensimmäinen versio käytti tummaa luumua, joka 16 px:ssä sulautui runkoon ja näytti harmaalta. Kirkas luumu
            on sama sävy vaaleampana.
          </p>
          <LogoColorways />

          <h3 class="mt-16 mb-2 text-[20px] font-semibold tracking-tight">Kuusi suuntaa</h3>
          <p class="mb-6 max-w-[62ch] text-[14.5px] leading-relaxed text-muted">
            Kaikki suunnat on piirretty 24 yksikön ruudukolle ilman jäljitettyjä referenssejä. Puolet esittää idean
            kuvana, ja jokainen testattiin faviconin koossa ennen valintaa.
          </p>
          <LogoDirections />
        </section>

        <!-- ───────── 02 Design system ───────── -->
        <section id="design-system" class="scroll-mt-8">
          <SectionHead n="02" title="Design system" accent="Viileät neutraalit, luumu ja lämmin aprikoosi">
            Kaikki harmaat ovat samaa viileää perhettä. Luumu on brändiväri: logo, korostettu teksti, valitut tilat ja
            CTA:n hover. Aprikoosi on lämmin tukiväri pinnoille, joilla tuotetta esitellään (bento-näyttämöt, UKK:n
            pallot), ja se tuo kylmään paletiin vähän kodin lämpöä. Aprikoosi ei koskaan ole tekstin tai napin väri.
            Puhdasta mustaa ei käytetä missään. Tokenit ovat CSS-muuttujina tiedostossa <code class="font-mono text-[13px]">global.css</code> ja
            datana tiedostossa <code class="font-mono text-[13px]">tokens.ts</code>.
          </SectionHead>

          <h3 class="mb-4 text-[15px] font-semibold">Värit</h3>
          <div class="flex flex-col gap-6">
            {
              grouped.map(([group, list]) => (
                <div>
                  <p class="mb-2 text-[12px] font-medium text-muted">{group}</p>
                  <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
                    {list.map((c) => (
                      <div class="overflow-hidden rounded-[1.25rem] border border-line bg-white">
                        <div class="h-20" style={`background:${c.hex}`} />
                        <div class="p-3">
                          <p class="flex items-baseline justify-between gap-2 text-[13px] font-semibold">
                            {c.name}
                            <span class="font-mono text-[11px] font-normal text-muted">{c.hex}</span>
                          </p>
                          <p class="mt-1 text-[11.5px] leading-snug text-muted">{c.use}</p>
                          <p class="mt-2 font-mono text-[10.5px] text-ink-soft">{c.contrast}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>

          <h3 class="mt-14 mb-4 text-[15px] font-semibold">Typografia · Geist ja Geist Mono</h3>
          <div class="divide-y divide-line overflow-hidden rounded-[1.5rem] border border-line bg-white">
            {
              typeScale.map((t) => (
                <div class="grid grid-cols-1 gap-2 p-5 md:grid-cols-[160px_1fr] md:items-baseline md:gap-6">
                  <div>
                    <p class="text-[13px] font-semibold">{t.name}</p>
                    <p class="font-mono text-[11px] text-muted">{t.spec}</p>
                    <p class="font-mono text-[11px] text-muted">mobiili {t.mobile} px</p>
                  </div>
                  <p
                    class:list={[
                      'min-w-0 truncate text-ink',
                      t.name === 'Display' && 'text-[40px] leading-[1.02] font-semibold tracking-[-0.035em] md:text-[56px]',
                      t.name === 'H2' && 'text-[30px] leading-[1.1] font-semibold tracking-[-0.03em] md:text-[40px]',
                      t.name === 'H3' && 'text-[20px] font-semibold tracking-[-0.01em]',
                      t.name === 'Body L' && 'text-[17px] text-muted',
                      t.name === 'Body' && 'text-[15px] text-muted',
                      t.name === 'Mono' && 'font-mono text-[14px]',
                    ]}
                  >
                    {t.sample}
                  </p>
                </div>
              ))
            }
          </div>
          <p class="mt-3 text-[13px] text-muted">
            Hinnat, kellonajat ja muut luvut ladotaan aina monospace-fontilla, jotta ne pysyvät linjassa.
          </p>

          <h3 class="mt-14 mb-4 text-[15px] font-semibold">Napit</h3>
          <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
            <div class="flex flex-col justify-between gap-8 rounded-[2rem] bg-canvas p-6 shadow-[inset_0_0_0_1px_var(--color-line)] md:p-8">
              <div class="flex flex-col items-start gap-5">
                <CtaButton href="#design-system" label="Tilaa siivous" />
                <div class="flex flex-wrap items-center gap-3">
                  <a href="#design-system" class="cx cx--sm cx--light cx--quiet">
                    <span class="cx-fill" aria-hidden="true"></span>
                    <span class="cx-label">Tilaa siivous</span>
                    <span class="cx-icon" aria-hidden="true"><ArrowRight size={16} weight="bold" className="cx-arrow" /></span>
                  </a>
                  <CtaButton href="#design-system" label="Tilaa siivous" size="sm" />
                </div>
                <a href="#design-system" class="press group/price -ml-3 flex items-baseline gap-1.5 rounded-full px-3 py-3 text-[15px] text-ink-soft transition-colors hover:bg-ink/[0.05] hover:text-ink">
                  Hinnat alkaen <span class="font-semibold text-ink">43 €/h</span>
                  <ArrowRight size={13} weight="bold" className="self-center transition-transform duration-200 ease-[var(--ease-out-strong)] group-hover/price:translate-x-0.5" />
                </a>
              </div>
              <p class="text-[13px] leading-relaxed text-muted">
                Vaalealla pohjalla: pää-CTA, navbarin pieni CTA levossa ja vierityksen jälkeen, sekä toissijainen
                tekstilinkki. Vie hiiri napin päälle.
              </p>
            </div>
            <div class="flex flex-col justify-between gap-8 rounded-[2rem] bg-ink p-6 text-white md:p-8">
              <div class="flex flex-col items-start gap-5">
                <CtaButton href="#design-system" label="Aloita varaus" variant="light" />
                <button type="button" class="press group flex items-center gap-2 rounded-full bg-white py-3.5 pr-4 pl-6 text-[15px] font-medium text-ink">
                  Tilaa
                  <ArrowSwap />
                </button>
              </div>
              <p class="text-[13px] leading-relaxed text-white/60">
                Tummalla pohjalla: vaalea pää-CTA ja lomakkeen lähetysnappi, jonka nuoli pyyhkäisee hoverissa uuden
                nuolen tilalle.
              </p>
            </div>
          </div>
          <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-3">
            <Rule title="Liike kertoo suunnan" text="Hoverissa pallo kasvaa nuolen kohdalta koko napin kokoiseksi luumuksi, ja nuoli kääntyy vinosta eteenpäin. Liike alkaa siitä kohdasta, johon katse jo osuu." />
            <Rule title="Yksi pää-CTA kerrallaan" text="Navbarin pieni CTA on hiljainen niin kauan kuin heron CTA näkyy, ja muuttuu tummaksi, kun se vierii pois. Ruudulla on aina vain yksi tumma pää-CTA." />
            <Rule title="Pilleri, aina" text="Kaikki napit ovat pillereitä. Mobiilissa ne eivät veny koko leveyteen. Kosketusnäytöllä ei ole hoveria, joten palautteen antaa painallus. Reduced motion vaihtaa värit ilman laajenemista." />
          </div>

          <div class="mt-14 grid grid-cols-1 gap-3 md:grid-cols-2">
            <div>
              <h3 class="mb-4 text-[15px] font-semibold">Pyöristykset</h3>
              <div class="divide-y divide-line overflow-hidden rounded-[1.5rem] border border-line bg-white">
                {
                  radii.map((r) => (
                    <div class="flex items-center gap-4 p-4">
                      <span class="size-10 shrink-0 border-2 border-ink/80 bg-mist-soft" style={`border-radius:min(${r.value}, 20px)`} />
                      <span class="flex-1">
                        <span class="block text-[13px] font-semibold">{r.name}</span>
                        <span class="block text-[12px] text-muted">{r.use}</span>
                      </span>
                      <span class="font-mono text-[11px] text-ink-soft">{r.value}</span>
                    </div>
                  ))
                }
              </div>
            </div>
            <div>
              <h3 class="mb-4 text-[15px] font-semibold">Ikonit · Phosphor duotone</h3>
              <div class="grid grid-cols-4 gap-2">
                {
                  [House, Truck, Key, Briefcase, Buildings, CalendarCheck, Star, ShieldCheck].map((I) => (
                    <span class="grid aspect-square place-items-center rounded-[1.25rem] border border-line bg-white text-ink">
                      <I size={26} weight="duotone" />
                    </span>
                  ))
                }
              </div>
              <p class="mt-3 text-[13px] text-muted">Ei emojeja. Ikonit ovat aina samaa sarjaa ja samalla painolla.</p>
            </div>
          </div>
        </section>

        <!-- ───────── 03 Liike ───────── -->
        <section id="liike" class="scroll-mt-8">
          <SectionHead n="03" title="Liike" accent="Nopea, syy-seuraus näkyvissä">
            Liike noudattaa Emil Kowalskin periaatteita: vahva ease-out kaikelle, mikä ilmestyy, lyhyet kestot ja
            sulkeminen aina avaamista nopeampi. Kaikki triggerillä avautuva kasvaa triggeristään, ja vain transformia
            ja opacityä animoidaan.
          </SectionHead>

          <div class="grid grid-cols-1 gap-3 lg:grid-cols-[1fr_300px]">
            <div class="flex flex-col gap-3">
              <div class="rounded-[2rem] bg-ink p-8 text-white md:p-10">
                <p class="mb-6 font-mono text-[11px] text-white/50">Live · sanan rullaus kirjainten korkuisessa maskissa, 600 ms ease-in-out</p>
                <p class="text-[36px] leading-[1.05] font-semibold tracking-[-0.035em] md:text-[52px]">
                  Siivoukset vaivattomasti
                  <RotatingWord client:visible words={['kotiin.', 'Airbnb:hen.', 'muuttoon.']} className="text-plum-light" />
                </p>
              </div>
              <div class="divide-y divide-line overflow-hidden rounded-[1.5rem] border border-line bg-white">
                {
                  motion.map((m) => (
                    <div class="grid grid-cols-1 gap-1 p-4 md:grid-cols-[170px_220px_1fr] md:items-baseline md:gap-4">
                      <span class="text-[13px] font-semibold">{m.name}</span>
                      <span class="font-mono text-[11px] text-ink-soft">{m.value}</span>
                      <span class="text-[12.5px] text-muted">{m.use}</span>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="flex flex-col items-center gap-3 rounded-[2rem] bg-mist-soft p-6">
              <p class="self-start font-mono text-[11px] text-ink-soft">Live · varausflow</p>
              <div class="w-full max-w-[250px]"><PhoneDemo client:visible /></div>
              <p class="text-center text-[12px] leading-relaxed text-ink-soft">
                Dynamic Island laajenee vahvistukseksi jousella. Mockup itse ei liiku.
              </p>
            </div>
          </div>
        </section>

        <!-- ───────── 04 Arkkitehtuuri ───────── -->
        <section id="arkkitehtuuri" class="scroll-mt-8">
          <SectionHead n="04" title="Arkkitehtuuri" accent="Valmis HTML, JavaScript vain siellä missä on liikettä">
            Nykyinen sivu renderöidään WordPressissä Elementor Pron sivurakentajalla jokaisella käynnillä tai
            välimuistista. Uusi sivu rakennetaan Astrolla valmiiksi HTML-tiedostoiksi, jotka jaetaan CDN:stä.
            Interaktiiviset osat, kuten valikot ja puhelindemo, ovat React-islandeja, jotka latautuvat vasta kun niitä
            tarvitaan.
          </SectionHead>

          <div class="rounded-[2rem] border border-line bg-white p-4 md:p-8">
            <svg viewBox="0 0 960 300" class="h-auto w-full" role="img" aria-label="Arkkitehtuurikaavio: sisältö WordPressistä tai CMS:stä buildiin, build CDN:ään, CDN selaimeen, varaus erillisessä sovelluksessa">
              <defs>
                <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                  <path d="M0 0 10 5 0 10z" fill="#6b717d"></path>
                </marker>
              </defs>
              <g font-family="Geist Variable, sans-serif" font-size="14">
                <rect x="10" y="40" width="200" height="96" rx="18" fill="#f1e8ee"></rect>
                <text x="30" y="76" font-weight="600" fill="#15171c">Sisältö</text>
                <text x="30" y="98" fill="#6b717d" font-size="12.5">WordPress-admin (vaihe 1)</text>
                <text x="30" y="116" fill="#6b717d" font-size="12.5">tai Git-CMS (vaihe 2)</text>

                <rect x="270" y="40" width="200" height="96" rx="18" fill="#15171c"></rect>
                <text x="290" y="76" font-weight="600" fill="#fff">Astro-build</text>
                <text x="290" y="98" fill="#ffffffa0" font-size="12.5">sivupohjat + data</text>
                <text x="290" y="116" fill="#ffffffa0" font-size="12.5">→ staattinen HTML</text>

                <rect x="530" y="40" width="190" height="96" rx="18" fill="#e6ecf6"></rect>
                <text x="550" y="76" font-weight="600" fill="#15171c">CDN</text>
                <text x="550" y="98" fill="#6b717d" font-size="12.5">Cloudflare Pages</text>
                <text x="550" y="116" fill="#6b717d" font-size="12.5">tai Netlify / Vercel</text>

                <rect x="780" y="40" width="170" height="96" rx="18" fill="#fff" stroke="#e3e6eb"></rect>
                <text x="800" y="76" font-weight="600" fill="#15171c">Selain</text>
                <text x="800" y="98" fill="#6b717d" font-size="12.5">HTML heti</text>
                <text x="800" y="116" fill="#6b717d" font-size="12.5">+ 4 pientä islandia</text>

                <path d="M210 88H262M470 88H522M720 88H772" stroke="#6b717d" stroke-width="1.5" marker-end="url(#ah)"></path>
