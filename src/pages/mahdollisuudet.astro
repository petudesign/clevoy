---
/**
 * /mahdollisuudet – what the redesign could make possible for Clevoy as a business:
 * the two-sided starting point, three hypotheses with metrics, the first experiment,
 * what each home-page section is meant to resolve, and the questions to ask Clevoy.
 * No numbers are invented: baselines have to come from Clevoy's own data.
 */
import Base from '../layouts/Base.astro'
import { Logo } from '../components/Logo'
import SectionHead from '../components/docs/SectionHead.astro'
import Rule from '../components/docs/Rule.astro'
import { ArrowUpRight } from '@phosphor-icons/react'

const hypotheses = [
  {
    n: 'H1',
    side: 'Ostajat',
    title: 'Kun hinta näkyy heti, useampi aloittaa varauksen',
    claim:
      'Jos hinta alkaen, kotitalousvähennys ja varauksen vaiheet näkyvät jo etusivulla, useampi kävijä siirtyy varaamaan.',
    why: 'Nykyisellä etusivulla hintaa ei mainita lainkaan (tarkistettu 19.11.2026). Siivouksen ostaja haluaa ensin tietää, paljonko se maksaa ja onko se vaikeaa. Uusi hero vastaa molempiin ennen ensimmäistä klikkausta.',
    primary: 'Etusivun kävijöistä app.clevoy.io:hon siirtyvien osuus',
    support: ['Aloitetuista varauksista valmiiksi asti tehdyt', 'Hintasivun ja UKK:n hintakysymyksen avaukset'],
    disproves:
      'Klikkaukset kasvavat, mutta valmiit varaukset eivät. Silloin hinta houkuttelee väärää ostajaa, tai pudotus tapahtuu sovelluksessa eikä sivulla.',
    pace: 'Nopea: näkyy viikoissa',
  },
  {
    n: 'H2',
    side: 'Ostajat',
    title: 'Kaupunkisivut alkavat tuoda varauksia haun kautta',
    claim:
      'Jos etusivu linkittää jokaiseen palvelu × kaupunki -sivuun ja sivut latautuvat nopeasti, kaupunkisivujen orgaaninen liikenne ja niiden kautta tulevat varaukset kasvavat.',
    why: 'Haut kuten "kotisiivous Espoo" kertovat valmiista ostoaikeesta. Nyt etusivulta ei linkitetä yhdellekään kaupunkisivulle, joten hakukone ei näe niitä tärkeinä.',
    primary: 'Kaupunkisivujen orgaanisista käynneistä alkaneet varaukset',
    support: ['Search Consolen näyttökerrat ja sijoitukset hauille "palvelu + kaupunki"', 'Kaupunkisivujen indeksointi ja latausaika'],
    disproves:
      'Liikenne kasvaa, mutta varauksia ei tule. Silloin kaupunkisivu ei vastaa hakijan kysymykseen: paikalliset hinnat, tarjoajat ja vapaat ajat puuttuvat.',
    pace: 'Hidas: 2–3 kuukautta',
  },
  {
    n: 'H3',
    side: 'Palveluntarjoajat',
    title: 'Näkyvämpi liittyminen tuo lisää vapaita aikoja',
    claim:
      'Jos palveluntarjoajaksi liittyminen näkyy etusivulla omana osionaan, liittymisiä tulee enemmän, ja ne näkyvät vapaina aikoina kaupungeissa, joissa niitä on nyt vähiten.',
    why: 'Clevoy on kaksipuolinen markkinapaikka. Ilman siivoojia ei ole vapaita aikoja, eikä paraskaan etusivu tuota varauksia, jos ensimmäinen vapaa aika on kahden viikon päästä.',
    primary: 'Aktivoituneet palveluntarjoajat (ensimmäinen hyväksytty varaus)',
    support: ['Liittymisen aloitukset etusivulta', 'Vapaat ajat ja ensimmäisen vapaan ajan odotus kaupungeittain'],
    disproves:
      'Liittymisiä tulee, mutta ne eivät aktivoidu. Silloin este on perehdytys tai työn määrä, ei se, että liittymistä ei löydä.',
    pace: 'Keskinopea: 1–2 kuukautta',
  },
]

const sections = [
  { s: 'Hero', doubt: 'Paljonko tämä maksaa, ja onko se vaikeaa?', answer: 'Hinta alkaen, kotitalousvähennys, arvosana ja varauksen eteneminen puhelimessa.' },
  { s: 'Kolme vaihetta', doubt: 'Mitä minun pitää tehdä?', answer: 'Kolme vaihetta yhdellä aikajanalla. Viimeinen kertoo, että siivousta voi seurata.' },
  { s: 'Bento', doubt: 'Voinko luottaa siihen, kuka tulee ja mitä se maksaa?', answer: 'Kokonaishinta ennen vahvistusta, oikeat arviot, vapaat ajat ja seuranta.' },
  { s: 'Siivous lähelläsi', doubt: 'Toimiiko tämä minun kaupungissani?', answer: 'Jokainen palvelu ja kaupunki omana linkkinään, ja palvelut erottuvat kuvista.' },
  { s: 'UKK', doubt: 'Mitä jos...?', answer: 'Hinta, kotitalousvähennys, kaupungit, palvelut, tilaaminen ja seuranta lyhyesti.' },
  { s: 'Palveluntarjoajille', doubt: 'Kannattaako minun liittyä?', answer: 'Viikoittaiset maksut, oma aikataulu ja näkymä siitä, miltä työ sovelluksessa näyttää.' },
  { s: 'Footer', doubt: 'En ole vielä valmis tilaamaan.', answer: 'Uutiskirje ja −10 % ensimmäisestä siivouksesta: syy palata myöhemmin.' },
]

const questions = [
  'Kumpi on nyt suurempi ongelma: uusien asiakkaiden hankinta vai riittävän palveluntarjoajaverkoston ylläpito?',
  'Missä kohtaa asiakkaat keskeyttävät varauksen: etusivulla, hinnan kohdalla vai sovelluksessa?',
  'Miten palveluntarjoajien saatavuus näkyy asiakkaalle? Kuinka pitkä on odotus ensimmäiseen vapaaseen aikaan eri kaupungeissa?',
  'Mitä dataa jo kerätään, mutta jota ei vielä käytetä päätöksissä? Onko varauspolku mitattu GTM:llä vaiheittain?',
  'Mistä nykyiset hyvät asiakkaat tulevat: haku, suositukset, mainonta vai yritysasiakkuudet?',
]
---

<Base title="Clevoy · Mahdollisuudet" description="Kolme liiketoiminnallista hypoteesia, mittarit ja ensimmäinen kokeilu Clevoyn uudistukselle.">
  <div class="overflow-x-clip pb-24">
    <!-- Cover -->
    <header class="px-3 pt-3 md:px-4 md:pt-4">
      <div class="reveal relative overflow-hidden rounded-[2rem] bg-ink text-white md:rounded-[2.5rem]">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_60%_at_85%_0%,rgba(184,103,159,0.35),transparent_70%)]"></div>
        <div class="relative mx-auto max-w-[1240px] px-5 pt-6 pb-10 md:px-10 md:pt-8 md:pb-14">
          <div class="flex items-center justify-between gap-4">
            <a href="/docs/" aria-label="Takaisin docsiin"><Logo variant="ikkuna" size={20} tone="dark" /></a>
            <span class="rounded-full border border-white/15 px-3 py-1.5 font-mono text-[11px] text-white/60">Liite docsiin · 19.11.2026</span>
          </div>
          <div class="mt-16 grid grid-cols-1 gap-10 md:mt-24 lg:grid-cols-[1.4fr_1fr] lg:items-end">
            <h1 class="text-[40px] leading-[1.02] font-semibold tracking-[-0.035em] sm:text-[56px] lg:text-[68px]">
              Mitä uudistus voisi <span class="text-plum-light">mahdollistaa</span> Clevoylle?
            </h1>
            <p class="max-w-[46ch] text-[16px] leading-relaxed text-white/65">
              Uusi sivu on keino, ei tavoite. Tässä on kolme hypoteesia siitä, miten uudistus voisi näkyä Clevoyn
              luvuissa, millä mittareilla ne todennetaan ja millä kokeilulla aloittaisin. Lukuja ei ole
              tarkoituksella: lähtötaso mitataan Clevoyn omasta datasta.
            </p>
          </div>
        </div>
      </div>
    </header>

    <main class="mx-auto flex max-w-[1240px] flex-col gap-24 px-4 pt-16 md:gap-32 md:px-8 lg:pt-24">
      <!-- 01 -->
      <section>
        <SectionHead n="01" title="Lähtökohta" accent="Kaksi ostajaa samalla sivulla">
          Clevoy on markkinapaikka. Asiakas ostaa siivouksen, ja palveluntarjoaja ostaa tavallaan asiakkaat. Kumpikin
          tulee sivulle omien epävarmuuksiensa kanssa, ja sivun pitää poistaa ne molemmilta.
        </SectionHead>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="rounded-[2rem] border border-line bg-white p-6 md:p-8">
            <p class="text-[13px] font-medium text-muted">Asiakas kysyy</p>
            <ul class="mt-4 flex flex-col gap-3 text-[17px] font-semibold tracking-[-0.01em] text-ink">
              <li>Paljonko tämä maksaa?</li>
              <li>Pääsenkö sopivaan aikaan?</li>
              <li>Voinko luottaa siihen, kuka tulee?</li>
              <li>Toimiiko tämä minun kaupungissani?</li>
            </ul>
          </div>
          <div class="rounded-[2rem] bg-ink p-6 text-white md:p-8">
            <p class="text-[13px] font-medium text-white/55">Palveluntarjoaja kysyy</p>
            <ul class="mt-4 flex flex-col gap-3 text-[17px] font-semibold tracking-[-0.01em]">
              <li>Saanko tätä kautta töitä?</li>
              <li>Milloin ja miten saan rahat?</li>
              <li>Päätänkö itse, milloin teen töitä?</li>
              <li>Paljonko työtä liittyminen vaatii?</li>
            </ul>
          </div>
        </div>
        <p class="mt-4 max-w-[70ch] text-[14px] leading-relaxed text-muted">
          Puolet ovat riippuvaisia toisistaan: ilman siivoojia ei ole vapaita aikoja, ja ilman vapaita aikoja
          paraskaan etusivu ei tuota varauksia. Siksi yksi kolmesta hypoteesista koskee palveluntarjoajia.
        </p>
      </section>

      <!-- 02 -->
      <section>
        <SectionHead n="02" title="Hypoteesit" accent="Kolme oletusta, jotka voi todentaa">
          Jokaisella on yksi päämittari, pari tukimittaria ja tulos, joka kumoaisi oletuksen. Kumoava tulos on yhtä
          arvokas kuin vahvistava, koska se kertoo, mihin seuraavaksi kannattaa katsoa.
        </SectionHead>
        <ol class="flex flex-col gap-3">
          {
            hypotheses.map((h, i) => (
              <li class={`grid grid-cols-1 gap-8 rounded-[2rem] p-6 md:p-8 lg:grid-cols-[1fr_1.1fr] lg:gap-12 ${i === 2 ? 'bg-plum text-white' : 'border border-line bg-white'}`}>
                <div>
                  <p class={`flex items-center gap-3 text-[13px] ${i === 2 ? 'text-white/70' : 'text-muted'}`}>
                    <span class={`font-mono text-[12px] ${i === 2 ? 'text-white' : 'text-plum'}`}>{h.n}</span>
                    {h.side}
                    <span class={`rounded-full px-2.5 py-0.5 text-[11px] ${i === 2 ? 'bg-white/15' : 'bg-canvas'}`}>{h.pace}</span>
                  </p>
                  <h3 class="mt-4 text-[24px] leading-[1.15] font-semibold tracking-[-0.02em] md:text-[28px]">{h.title}</h3>
                  <p class={`mt-4 text-[15px] leading-relaxed ${i === 2 ? 'text-white/85' : 'text-ink-soft'}`}>{h.claim}</p>
                  <p class={`mt-3 text-[14px] leading-relaxed ${i === 2 ? 'text-white/65' : 'text-muted'}`}>{h.why}</p>
                </div>
                <dl class={`flex flex-col divide-y rounded-[1.5rem] ${i === 2 ? 'divide-white/15 bg-white/[0.08]' : 'divide-line bg-canvas'}`}>
                  <div class="p-5">
                    <dt class={`text-[12px] font-medium ${i === 2 ? 'text-white/60' : 'text-muted'}`}>Päämittari</dt>
                    <dd class="mt-1 text-[15px] font-semibold">{h.primary}</dd>
                  </div>
                  <div class="p-5">
                    <dt class={`text-[12px] font-medium ${i === 2 ? 'text-white/60' : 'text-muted'}`}>Tukimittarit</dt>
                    <dd class="mt-1">
                      <ul class="flex flex-col gap-1 text-[14px]">
                        {h.support.map((x) => <li>{x}</li>)}
                      </ul>
                    </dd>
                  </div>
                  <div class="p-5">
                    <dt class={`text-[12px] font-medium ${i === 2 ? 'text-white/60' : 'text-muted'}`}>Mikä kumoaisi</dt>
                    <dd class={`mt-1 text-[14px] leading-relaxed ${i === 2 ? 'text-white/80' : 'text-ink-soft'}`}>{h.disproves}</dd>
                  </div>
                </dl>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- 03 -->
      <section>
        <SectionHead n="03" title="Ensimmäinen kokeilu" accent="Uusi hero nykyiselle sivulle, A/B-testinä">
          Aloittaisin H1:stä. Se on nopein todentaa, eikä se vaadi siirtymää: hero on jo valmis, ja sen voi testata
          nykyisen WordPress-sivun päällä ennen kuin mitään muuta päätetään.
        </SectionHead>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-[1.2fr_1fr]">
          <ol class="divide-y divide-line overflow-hidden rounded-[2rem] border border-line bg-white">
            {
              [
                ['Mitä', 'Nykyinen etusivun yläosa vastaan uusi hero: otsikko, hinta alkaen, kotitalousvähennys, arvosana ja sama CTA.'],
                ['Miten', 'Kävijät jaetaan puoliksi kahteen versioon. CTA-klikkaukselle oma GTM-tapahtuma ja app.clevoy.io-linkkiin UTM-tunniste, jotta varaukset voidaan yhdistää versioon.'],
                ['Kesto', 'Vähintään kaksi täyttä viikkoa viikonpäivien vaihtelun takia, ja niin kauan, että kummallakin versiolla on riittävästi klikkauksia. Tarkka kesto lasketaan Clevoyn nykyisestä kävijämäärästä.'],
                ['Onnistui, jos', 'Päämittari paranee, eikä valmiiden varausten osuus aloituksista laske.'],
                ['Jos liikennettä on vähän', 'A/B-testin sijaan kaksi laskeutumissivua samalla mainosbudjetilla. Hitaampi signaali, mutta sama kysymys.'],
              ].map(([k, v]) => (
                <li class="grid grid-cols-1 gap-1 p-5 md:grid-cols-[150px_1fr] md:gap-6 md:p-6">
                  <span class="text-[14px] font-semibold">{k}</span>
                  <span class="text-[14px] leading-relaxed text-muted">{v}</span>
                </li>
              ))
            }
          </ol>
          <div class="flex flex-col gap-3">
            <Rule title="Miksi juuri tämä" text="Pieni työ ja nopea vastaus. Se kertoo, toimiiko uusi viesti, ennen kuin koko sivua siirretään. Jos ei toimi, siirtymän perusteeksi jäävät nopeus, ylläpito ja SEO, ja ne arvioidaan omina asioinaan." />
            <Rule title="Mitä tarvitaan Clevoylta" text="Pääsy GTM:ään ja analytiikkaan, nykyinen kävijämäärä ja tieto siitä, voiko app.clevoy.io:n varaukset yhdistää UTM-tunnisteeseen." />
            <Rule title="Mitä ei vielä tehdä" text="Kaupunkisivuja ja palveluntarjoajaosiota ei testata samaan aikaan. Yksi muutos kerrallaan, jotta tulos kertoo, mikä sen aiheutti." />
          </div>
        </div>
      </section>

      <!-- 04 -->
      <section>
        <SectionHead n="04" title="Osiot" accent="Mitä kukin osio ratkaisee">
          Jokainen etusivun osio vastaa yhteen kysymykseen, joka voi estää varauksen tai liittymisen. Jos osiolle ei
          löydy kysymystä, sitä ei tarvita.
        </SectionHead>
        <div class="overflow-x-auto rounded-[1.5rem] border border-line bg-white">
          <table class="w-full min-w-[680px] text-left text-[13.5px]">
            <thead class="bg-canvas text-[12px] text-muted">
              <tr><th class="p-4 font-medium">Osio</th><th class="p-4 font-medium">Kävijän epävarmuus</th><th class="p-4 font-medium">Miten sivu vastaa</th></tr>
            </thead>
            <tbody class="divide-y divide-line align-top">
              {
                sections.map((r) => (
                  <tr>
                    <td class="p-4 font-semibold whitespace-nowrap">{r.s}</td>
                    <td class="p-4">”{r.doubt}”</td>
                    <td class="p-4 text-muted">{r.answer}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- 05 -->
      <section>
        <SectionHead n="05" title="Kysymykset Clevoylle" accent="Mitä kysyisin ensimmäisessä palaverissa">
          Nämä ratkaisevat, mihin hypoteesiin kannattaa panostaa. Vastaukset voivat muuttaa järjestystä: jos suurin
          ongelma on tarjonta, H3 menee H1:n edelle.
        </SectionHead>
        <ol class="flex flex-col gap-2">
          {
            questions.map((q, i) => (
              <li class="flex gap-5 rounded-[1.5rem] border border-line bg-white p-5 md:p-6">
                <span class="font-mono text-[12px] text-plum">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-[15px] leading-relaxed text-ink">{q}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <footer class="flex flex-col items-start justify-between gap-4 border-t border-line pt-8 text-[13px] text-muted md:flex-row md:items-center">
        <Logo variant="ikkuna" size={16} />
        <p>Konseptiehdotus. Ei Clevoy Oy:n virallista materiaalia.</p>
        <span class="flex gap-5">
          <a href="/docs/" class="inline-flex items-center gap-1 text-ink hover:underline">Docs <ArrowUpRight size={13} /></a>
          <a href="/" class="inline-flex items-center gap-1 text-ink hover:underline">Etusivu <ArrowUpRight size={13} /></a>
        </span>
      </footer>
    </main>
  </div>
</Base>
