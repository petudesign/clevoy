---
/**
 * Footer – one dark inset panel (same frame as the other panels):
 *   1. Newsletter bar: Clevoy's own offer (−10 % on the first cleaning, from clevoy.io).
 *      In this preview the form does NOT post anywhere – in production it posts to Brevo
 *      like today's form does. Inline validation, no page reload.
 *   2. Link columns: services, cities (more local-SEO links), company, app + social.
 *   3. Legal row. All slugs mirror clevoy.io's current pages.
 *   4. Sign-off wordmark: the Ikkuna mark turned a quarter stands in for the C. It turns
 *      once when the word scrolls into view (window → C). The panel runs to the page bottom.
 */
import { ArrowRight, InstagramLogo, TiktokLogo } from '@phosphor-icons/react'
import { Logo, WindowMarkSoft } from './Logo'
import { ArrowSwap } from './ArrowSwap'
import { org, serviceCities, cityHref } from '../data/site'

const company = [
  { label: 'Mikä Clevoy on', href: '/mika-clevoy-on/' },
  { label: 'Liity palveluntarjoajaksi', href: '/liity-palveluntarjoajaksi/' },
  { label: 'Blogi', href: '/blogi/' },
  { label: 'Referenssit', href: '/referenssit/' },
  { label: 'UKK', href: '/ukk/' },
  { label: 'Yhteystiedot', href: '/yhteystiedot/' },
]
const services = [
  ...serviceCities.map((s) => ({ label: s.service, href: `/${s.slug}/` })),
  { label: 'Toimistosiivous', href: '/toimistosiivous/' },
]
const home = serviceCities.find((s) => s.slug === 'kotisiivous')!
const legal = [
  { label: 'Tietosuojaseloste', href: '/tietosuojaseloste/' },
  { label: 'Yleiset käyttöehdot', href: '/ehdot/' },
  { label: 'Asiakkaiden erityisehdot', href: '/asiakkaiden-erityisehdot/' },
  { label: 'Palveluntarjoajien erityisehdot', href: '/palveluntarjoajat-erityisehdot/' },
]
const year = new Date().getFullYear()
---

<footer class="px-3 pt-24 md:px-4 md:pt-32">
  <div class="relative overflow-hidden rounded-t-[2rem] bg-ink text-white md:rounded-t-[2.5rem]">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_60%_at_0%_0%,rgba(184,103,159,0.22),transparent_70%)]"
    >
    </div>

    <div class="relative mx-auto max-w-[1240px] px-5 md:px-8">
      {/* 1 · Newsletter */}
      <div class="grid grid-cols-1 gap-8 border-b border-white/10 py-12 md:py-16 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16">
        <div>
          <h2 class="text-[30px] leading-[1.08] font-semibold tracking-[-0.03em] md:text-[40px]">
            Tilaa uutiskirje ja saat <span class="text-plum-light">−10 %</span> ensimmäisestä siivouksesta
          </h2>
          <p class="mt-3 max-w-[46ch] text-[15px] leading-relaxed text-white/65">
            Vinkkejä kodin hoitoon ja tieto uusista palveluista. Ei roskapostia, ja voit perua tilauksen milloin tahansa.
          </p>
        </div>

        <form class="newsletter" novalidate data-newsletter>
          <label for="nl-email" class="mb-2 block text-[13px] font-medium text-white/75">Sähköposti</label>
          <div class="flex flex-col gap-2 sm:flex-row">
            <input
              id="nl-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              required
              placeholder="nimi@esimerkki.fi"
              aria-describedby="nl-help nl-error"
              class="min-w-0 flex-1 rounded-full bg-white/[0.08] px-5 py-3.5 text-[15px] text-white shadow-[inset_0_0_0_1px_rgba(255,255,255,0.14)] outline-none placeholder:text-white/40 focus:shadow-[inset_0_0_0_1.5px_#d08cbb] aria-[invalid=true]:shadow-[inset_0_0_0_1.5px_#f08a8a]"
            />
            <button
              type="submit"
              class="press group flex items-center justify-center gap-2 rounded-full bg-white py-3.5 pr-4 pl-6 text-[15px] font-medium text-ink"
            >
              Tilaa
              <ArrowSwap />
            </button>
          </div>
          <p id="nl-error" class="mt-2 hidden text-[13px] text-[#f5a3a3]" role="alert"></p>
          <p id="nl-help" class="mt-2 text-[12.5px] text-white/50">
            Käsittelemme tietojasi <a href="/tietosuojaseloste/" class="underline decoration-white/30 underline-offset-[3px] hover:text-white">tietosuojaselosteen</a> mukaisesti.
          </p>
          <p class="nl-ok mt-2 hidden text-[14px] text-white" role="status">
            Kiitos! Esikatselussa tilausta ei lähetetä. Tuotannossa lomake lähettää tilauksen Brevoon.
          </p>
        </form>
      </div>

      {/* 2 · Links */}
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 py-12 md:grid-cols-4 md:py-16 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
        <div class="col-span-2 md:col-span-4 lg:col-span-1">
          <Logo variant="ikkuna" size={22} tone="dark" />
          <p class="mt-4 max-w-[30ch] text-[15px] leading-relaxed text-white/65">
            Löydä ja osta siivous samasta paikasta. Hinnat ja vapaat ajat näkyvät ennen varausta.
          </p>
          <div class="mt-6 flex items-center gap-2">
            <a href={org.sameAs[0]} aria-label="Clevoy Instagramissa" class="press grid size-10 place-items-center rounded-full bg-white/[0.08] text-white/80 hover:bg-white/[0.14] hover:text-white">
              <InstagramLogo size={18} weight="fill" />
            </a>
            <a href={org.sameAs[1]} aria-label="Clevoy TikTokissa" class="press grid size-10 place-items-center rounded-full bg-white/[0.08] text-white/80 hover:bg-white/[0.14] hover:text-white">
              <TiktokLogo size={18} weight="fill" />
            </a>
          </div>
        </div>

        <nav aria-labelledby="f-palvelut">
          <h3 id="f-palvelut" class="col-title">Palvelut</h3>
          <ul class="col-list">
            {services.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>

        <nav aria-labelledby="f-kaupungit">
          <h3 id="f-kaupungit" class="col-title">Kotisiivous kaupungeittain</h3>
          <ul class="col-list">
            {home.cities.map((c) => <li><a href={cityHref(home.slug, c)}>{c}</a></li>)}
          </ul>
        </nav>

        <nav aria-labelledby="f-clevoy">
          <h3 id="f-clevoy" class="col-title">Clevoy</h3>
          <ul class="col-list">
            {company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      </div>

      {/* 3 · Legal */}
      <div class="flex flex-col gap-4 border-t border-white/10 py-6 text-[13px] text-white/55 md:flex-row md:items-center md:justify-between">
        <p>Uudistuskonsepti, ei Clevoy Oy:n virallinen sivusto. Hinnat sisältävät arvonlisäveron.</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {legal.map((l) => <li><a href={l.href} class="hover:text-white">{l.label}</a></li>)}
        </ul>
      </div>
    </div>

    {/* Oversized wordmark – sign-off, decorative only. The turned window is the C. */}
    <div aria-hidden="true" class="pointer-events-none relative -mb-[0.06em] flex select-none justify-center px-5 text-[clamp(88px,22vw,320px)] leading-none font-semibold tracking-[-0.06em] text-white/[0.16] md:px-8" data-signoff>
      <span class="signoff-c"><WindowMarkSoft size={320} ink="rgb(255 255 255 / 0.16)" accent="rgb(208 140 187 / 0.6)" /></span><span>levoy</span>
    </div>
  </div>
</footer>

<style>
  .col-title {
    font-size: 13px;
    font-weight: 500;
    color: rgb(255 255 255 / 0.5);
  }
  .col-list {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-size: 15px;
  }
  .col-list a {
    color: rgb(255 255 255 / 0.85);
    transition: color 150ms ease;
  }
  .col-list a:hover {
    color: #fff;
  }

  /* Sign-off: turned mark ≈ cap height, ink on the baseline, normal letter spacing to "levoy" */
  [data-signoff] {
    align-items: baseline;
  }
  .signoff-c {
    display: inline-flex;
    width: 0.96em;
    margin-right: -0.05em;
    margin-left: -0.08em;
    transform: translateY(0.14em);
  }
  .signoff-c :global(svg) {
    width: 0.96em;
    height: 0.96em;
    transform-origin: 50% 50%;
    transform: rotate(-90deg);
  }
  /* armed = scripted and still below the fold: start as an upright window */
  [data-signoff].is-armed .signoff-c :global(svg) {
    transform: rotate(0deg);
  }
  [data-signoff].is-armed.is-in .signoff-c :global(svg) {
    transform: rotate(-90deg);
    transition: transform 1100ms var(--ease-in-out-strong) 300ms;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-signoff].is-armed .signoff-c :global(svg) {
      transform: rotate(-90deg);
      transition: none;
    }
  }
</style>

<script>
  // Sign-off turn: only arm it if the word is not already on screen (no jump at load).
  const signoff = document.querySelector<HTMLElement>('[data-signoff]')
  if (signoff && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const r = signoff.getBoundingClientRect()
    if (r.top > innerHeight) {
      signoff.classList.add('is-armed')
      const io = new IntersectionObserver(
        (es) => {
          if (es.some((e) => e.isIntersecting)) {
            signoff.classList.add('is-in')
            io.disconnect()
          }
        },
        { threshold: 0.5 },
      )
      io.observe(signoff)
    }
  }

  // Preview behaviour: validate inline, never post. In production: POST to Brevo.
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type=email]')!
    const error = form.querySelector<HTMLElement>('#nl-error')!
    const ok = form.querySelector<HTMLElement>('.nl-ok')!
    const help = form.querySelector<HTMLElement>('#nl-help')!
    const showError = (msg: string) => {
      input.setAttribute('aria-invalid', 'true')
      error.textContent = msg
      error.classList.remove('hidden')
    }
    input.addEventListener('input', () => {
      input.removeAttribute('aria-invalid')
      error.classList.add('hidden')
    })
    form.addEventListener('submit', (e) => {
      e.preventDefault()
      const v = input.value.trim()
      if (!v) return showError('Kirjoita sähköpostiosoite.')
      if (!input.checkValidity()) return showError('Tarkista sähköpostiosoite, esimerkiksi nimi@esimerkki.fi.')
      help.classList.add('hidden')
      ok.classList.remove('hidden')
      input.value = ''
    })
  })
</script>
