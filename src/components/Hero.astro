---
/**
 * Hero is static HTML. Only two islands ship JavaScript:
 *  - RotatingWord (client:idle) – the word swap
 *  - PhoneDemo (client:visible) – the booking loop, hydrated when on screen
 * Entrance animation is pure CSS (.reveal / .reveal-visual in global.css).
 */
import { ArrowRight, Star } from '@phosphor-icons/react'
import { RotatingWord } from './RotatingWord'
import { PhoneDemo } from './PhoneDemo'
import { ArrowSwap } from './ArrowSwap'
import CtaButton from './CtaButton.astro'
import { Image } from 'astro:assets'

// Optional photo: drop src/assets/hero.(jpg|png|webp) and it is optimised (AVIF/WebP, srcset)
// and tinted plum. Without it the card stays a pure colour field.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/hero.{jpg,jpeg,png,webp}', { eager: true })
const photo = Object.values(photos)[0]?.default

const words = ['kotiin.', 'Airbnb:hen.', 'muuttoon.']
// From Clevoy's Trustmary widget (trustmary.com/pEEtmFZuo) on 2026-11-18.
// TODO: fetch at build time so the number can't go stale.
const rating = { score: 4.8, label: '4,8', count: 38 }
// Fill per star: 4.8 → four full stars and one at 80 %
const stars = Array.from({ length: 5 }, (_, i) => Math.max(0, Math.min(1, rating.score - i)))
// Facts, each with a source:
// - price: clevoy.io/kotisiivous-helsinki + /kotisiivous-tampere meta descriptions (2026-11-18)
// - tax credit: vero.fi, kotitalousvähennyksen määrä 2026: 40 % työn osuudesta, max 2 100 €, omavastuu 150 €
// - review: Clevoy's Trustmary widget on clevoy.io, Juulia I., ~2 months before 2026-11-18
const facts = { fromPrice: '43 €/h', taxCredit: '40 %' }
// ratingValue 5 per Trustmary's schema.org data on clevoy.io (aggregate 4.82 / 38)
const review = { text: 'Siivous sujui loistavasti! Saatiin ihanan puhdas ja raikas koti.', name: 'Juulia I.', stars: 5 }
const appLinks = {
  apple: 'https://apps.apple.com/fi/app/clevoy/id6758142948?l=fi',
  google: 'https://play.google.com/store/apps/details?id=io.clevoy.app',
}
// Colour options for the visual card. Compare in dev with /?vari=luumu | aamuvalo | pastelli | vanha
// When the Figma photo exists, put it in /public/hero.jpg and layer it under the light.
const variants = {
  luumu: {
    bg: 'radial-gradient(70% 55% at 88% 8%, rgba(232,170,212,0.85) 0%, rgba(208,140,187,0) 60%), radial-gradient(90% 70% at 0% 100%, rgba(40,22,36,0.55) 0%, rgba(40,22,36,0) 60%), linear-gradient(160deg, #96608a 0%, #7a4a6e 45%, #5a3352 100%)',
  },
  aamuvalo: {
    bg: 'radial-gradient(60% 50% at 90% 6%, rgba(255,214,140,0.95) 0%, rgba(240,180,76,0.45) 30%, rgba(240,180,76,0) 62%), radial-gradient(90% 70% at 0% 100%, rgba(40,22,36,0.55) 0%, rgba(40,22,36,0) 60%), linear-gradient(160deg, #96608a 0%, #7a4a6e 45%, #5a3352 100%)',
  },
  pastelli: {
    bg: 'radial-gradient(70% 60% at 88% 8%, #ffffff 0%, rgba(255,255,255,0) 60%), linear-gradient(160deg, #f4e7ef 0%, #e6cfdf 50%, #d3bfe0 100%)',
  },
  vanha: {
    bg: 'radial-gradient(120% 80% at 85% 10%, #ffffff 0%, rgba(255,255,255,0) 55%), linear-gradient(160deg, #dfe7f3 0%, #c7d4ea 55%, #b9c6de 100%)',
  },
} as const
const v = variants.luumu
const isDev = import.meta.env.DEV
---

<section
  class="relative mx-auto grid max-w-[1240px] grid-cols-1 items-center gap-8 lg:content-center lg:items-stretch px-4 pt-6 pb-12 sm:gap-14 sm:pt-14 sm:pb-20 md:px-8 lg:min-h-[calc(100dvh-88px-40px)] lg:grid-cols-[1.05fr_1fr] lg:gap-10 lg:pt-16 lg:pb-12"
>
  {/* lg: top of "S" lines up with the card top, trust row with the card bottom; the slack goes only above the trust row */}
  <div class="flex flex-col items-start">
    <h1
      class="reveal text-[clamp(40px,14vw,56px)] leading-[1.02] lg:-mt-[0.14em] font-semibold tracking-[-0.035em] text-ink sm:text-[56px] lg:text-[68px]"
      style="--i:0"
    >
      Siivoukset<br />vaivattomasti
      <RotatingWord client:idle words={words} className="text-plum" />
    </h1>

    <p class="reveal mt-4 max-w-[46ch] text-[16px] leading-relaxed text-muted sm:mt-6 sm:text-[17px]" style="--i:1">
      Vertaa siivousyrityksiä, näe hinta etukäteen ja varaa sopiva aika muutamalla klikkauksella. Kertasiivouksena
      tai säännöllisesti viikon, kahden tai neljän viikon välein.
    </p>

    <div
      class="reveal mt-6 flex flex-wrap items-center gap-2 sm:mt-10 sm:gap-3"
      style="--i:2"
    >
      <CtaButton id="hero-cta" href="https://app.clevoy.io/" label="Tilaa siivous" />
      <a
        href="https://clevoy.io/kotisiivous/"
        class="press group/price flex items-baseline gap-1.5 rounded-full px-3 py-3.5 text-[14px] text-ink-soft sm:px-5 sm:text-[15px] transition-colors hover:bg-ink/[0.05] hover:text-ink"
      >
        Hinnat alkaen <span class="font-semibold text-ink">{facts.fromPrice}</span>
        <ArrowRight
          size={13}
          weight="bold"
          className="hidden self-center text-ink-soft transition-transform duration-200 ease-[var(--ease-out-strong)] group-hover/price:translate-x-0.5 sm:block"
        />
      </a>
    </div>

    {/*
      Official badges, unmodified. Apple first (Apple's guideline when shown together). Both have a
      visible height of 40 px (Apple's on-screen minimum); Google's PNG has transparent padding
      (29/250 top and bottom), so it is scaled to 52 px with negative margins. Gap 12 px > Apple's
      clear space of 1/4 badge height.
    */}
    <div class="reveal mt-8 flex flex-col items-start gap-3 sm:mt-12 lg:mt-auto lg:pt-10" style="--i:3">
      <p class="flex items-center gap-2.5 text-[14px] text-muted sm:text-[15px]">
        <span class="flex gap-0.5" role="img" aria-label={`Arvosana ${rating.label} / 5`}>
          {
            stars.map((fill) => (
              <span class="relative inline-block size-[18px]">
                <Star size={18} weight="fill" className="absolute inset-0 text-line" />
                {fill > 0 && (
                  <span class="absolute inset-0 overflow-hidden" style={`width:${fill * 100}%`}>
                    <Star size={18} weight="fill" className="text-star" />
                  </span>
                )}
              </span>
            ))
          }
        </span>
        <span class="text-[16px] font-semibold text-ink tabular-nums sm:text-[17px]">{rating.label}</span>
        <span>{rating.count} arvostelua</span>
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a href={appLinks.apple} aria-label="Lataa Clevoy App Storesta" class="press block rounded-[8px]">
          <img src="/badges/app-store-fi.svg" alt="Lataa App Storesta" width="143" height="40" class="block h-10 w-auto" />
        </a>
        <a href={appLinks.google} aria-label="Lataa Clevoy Google Playsta" class="press block rounded-[8px]">
          <img
            src="/badges/google-play-fi.png"
            alt="Lataa se Google Playsta"
            width="134"
            height="52"
            class="-my-[6px] block h-[52px] w-auto"
          />
        </a>
      </div>

    </div>
  </div>

  <div class="reveal-visual relative mx-auto w-full max-w-[560px] lg:self-start">
  <div class="relative overflow-hidden rounded-[2rem] lg:overflow-visible lg:rounded-none">
    <div class="relative aspect-[4/3.7] w-full overflow-hidden rounded-[2rem] bg-plum sm:aspect-[4/4.4]">
      {
        photo && (
          <Image
            src={photo}
            alt=""
            widths={[480, 720, 1120]}
            sizes="(min-width: 1024px) 560px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-[50%_18%] saturate-[0.7] sepia-[0.12] lg:object-center"
          />
        )
      }
      <div
        id="hero-visual-bg"
        class:list={['absolute inset-0', photo && 'hidden']}
        style={`background-image:${v.bg}`}
      >
      </div>
      {
        photo && (
          <div
            aria-hidden="true"
            class="absolute inset-0"
            style="background:linear-gradient(180deg, rgb(122 74 110 / 0.10) 0%, rgb(122 74 110 / 0.22) 45%, rgb(70 38 62 / 0.62) 100%), radial-gradient(120% 90% at 50% 40%, transparent 55%, rgb(40 22 36 / 0.35) 100%)"
          />
        )
      }
      <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink/10 to-transparent"></div>

      {/* Fact chip: vero.fi 2026 – 40 % of the work cost, max 2 100 € / person, omavastuu 150 € */}
      <p
        class="absolute top-4 left-1/2 z-10 flex -translate-x-1/2 items-center gap-2 rounded-full bg-white py-1.5 pr-3.5 pl-1.5 text-[12.5px] whitespace-nowrap text-ink-soft shadow-[0_6px_16px_-8px_rgba(21,23,28,0.4)] lg:hidden"
      >
        <span class="rounded-full bg-plum px-2 py-0.5 text-[11.5px] font-semibold text-white">{facts.taxCredit}</span>
        kotitalousvähennys työn osuudesta
      </p>
    </div>

    {/* Desktop: the tax-credit chip overhangs the top-left edge, balancing the review card bottom-right */}
    <p
      class="absolute top-[3%] left-[-28px] z-10 hidden items-center gap-2 rounded-full bg-white py-2 pr-4 pl-2 text-[13px] whitespace-nowrap text-ink-soft shadow-[0_0_0_1px_var(--color-line),0_18px_40px_-16px_rgba(21,23,28,0.35)] lg:flex"
    >
      <span class="rounded-full bg-plum px-2.5 py-0.5 text-[12px] font-semibold text-white">{facts.taxCredit}</span>
      kotitalousvähennys työn osuudesta
    </p>

    {/* Real review, overlapping the card edge (desktop – on mobile the card is clipped) */}
    <figure
      class="absolute right-[-28px] bottom-[12%] z-10 hidden w-[260px] rounded-[1.5rem] bg-white p-4 shadow-[0_0_0_1px_var(--color-line),0_18px_40px_-16px_rgba(21,23,28,0.35)] lg:block"
    >
      <span class="flex gap-0.5 text-star" role="img" aria-label={`${review.stars} / 5 tähteä`}>
        {Array.from({ length: review.stars }).map(() => <Star size={13} weight="fill" />)}
      </span>
      <blockquote class="mt-2 text-[13.5px] leading-snug font-medium text-ink">”{review.text}”</blockquote>
      <figcaption class="mt-2 text-[12.5px] text-ink-soft">{review.name} · Trustmary-arvio</figcaption>
    </figure>

    <div
      class="absolute top-[19%] left-1/2 w-[70%] min-w-[236px] max-w-[270px] -translate-x-1/2 sm:w-[58%] lg:top-1/2 lg:left-[38%] lg:-translate-y-[40%]"
    >
      <PhoneDemo client:visible />
    </div>
  </div>
  </div>
</section>

{
  /* Dev only: /?vari=aamuvalo etc. swaps the card colour for comparison */
  isDev && (
    <script is:inline define:vars={{ variants }}>
      const k = new URLSearchParams(location.search).get('vari')
      const v = k && variants[k]
      if (v) {
        document.getElementById('hero-visual-bg').style.backgroundImage = v.bg
      }
    </script>
  )
}
