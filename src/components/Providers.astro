---
import { ArrowSwap } from './ArrowSwap'
import CtaButton from './CtaButton.astro'
/**
 * For cleaning providers – the supply side of the marketplace. A different audience,
 * so a different frame: one large white card, copy left, the *provider's* view of the
 * app right (on a dark stage). No earnings figures in the mock: that would read as a promise.
 * Copy is Clevoy's own from clevoy.io ("Yrittäjille & ammattilaisille").
 * The navbar's "Liity palveluntarjoajaksi" scrolls here (#palveluntarjoajaksi).
 * Stage: a cleaning photo sits under the dark ink as a filter (texture, not subject),
 * so the app card stays the focus in the middle. Pexels 6195194, a placeholder until Clevoy's own photos.
 */
import { Image } from 'astro:assets'
import providerPhoto from '../assets/provider-stage.jpg'
import { ArrowRight, CalendarCheck, ChartLineUp, Check, Toolbox, Wallet } from '@phosphor-icons/react'
import { WindowMark } from './Logo'

const perks = [
  { icon: Wallet, title: 'Viikoittaiset maksut', text: 'Rahasi tilille säännöllisesti.' },
  { icon: CalendarCheck, title: 'Joustava aikataulu', text: 'Päätä itse, milloin työskentelet.' },
  { icon: ChartLineUp, title: 'Kasvata liiketoimintaa', text: 'Saa lisää uusia varauksia.' },
  { icon: Toolbox, title: 'Ammattilaistyökalut', text: 'Kaikki mitä tarvitset yhdessä paikassa.' },
]
const bookings = [
  { day: 'Ke 26.11.', time: '10.00', what: 'Kotisiivous · 62 m²', where: 'Kallio' },
  { day: 'To 27.11.', time: '13.30', what: 'Muuttosiivous · 48 m²', where: 'Tapiola' },
]
---

<section id="palveluntarjoajaksi" aria-labelledby="tarjoajat-otsikko" class="scroll-mt-24 px-3 pt-24 md:px-4 md:pt-32">
  <div
    class="grid grid-cols-1 gap-3 rounded-[2rem] bg-white p-3 shadow-[0_0_0_1px_var(--color-line)] md:rounded-[2.5rem] md:p-4 lg:grid-cols-[1fr_1fr]"
  >
    <div class="flex flex-col justify-between gap-10 px-4 py-8 md:px-8 md:py-12 lg:py-14" data-reveal-item style="--seq:0">
      <div>
        <h2 id="tarjoajat-otsikko" class="text-[clamp(26px,8vw,34px)] leading-[1.05] font-semibold tracking-[-0.03em] text-ink md:text-[48px]">
          Rakenna siivousliiketoimintasi Clevoyssa
        </h2>
        <p class="mt-5 max-w-[46ch] text-[16px] leading-relaxed text-muted">
          Olitpa yksinyrittäjä tai johdat tiimiä, me tuomme asiakkaat, hoidamme maksut ja annamme sinun keskittyä
          siihen, missä olet paras.
        </p>

        <ul class="mt-10 grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
          {
            perks.map((p) => (
              <li class="flex gap-3">
                <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-plum-soft text-plum">
                  <p.icon size={18} weight="duotone" />
                </span>
                <span>
                  <span class="block text-[15px] font-semibold text-ink">{p.title}</span>
                  <span class="mt-0.5 block text-[14px] leading-snug text-muted">{p.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <CtaButton href="/liity-palveluntarjoajaksi/" label="Liity palveluntarjoajaksi" />
        <span class="text-[14px] text-muted">Liittyminen on maksutonta.</span>
      </div>
    </div>

    {/* The provider's side of the app */}
    <div
      aria-hidden="true"
      class="relative grid min-h-[380px] place-items-center overflow-hidden rounded-[1.5rem] bg-ink px-5 py-12 md:rounded-[1.75rem]"
      data-reveal-item
      style="--seq:1"
    >
      <Image
        src={providerPhoto}
        alt=""
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading="lazy"
        class="stage-photo absolute inset-0 h-full w-full object-cover object-[20%_40%] grayscale"
      />
      {/* the filter: ink over the photo, plum light from the top right as before */}
      <div class="pointer-events-none absolute inset-0 bg-ink/[0.66]"></div>
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(70%_60%_at_80%_10%,rgba(184,103,159,0.3),transparent_70%)]"></div>

      <div class="relative w-full max-w-[360px] rounded-[1.25rem] bg-canvas p-4 text-ink shadow-[0_0_0_1px_rgba(255,255,255,0.08),0_30px_60px_-24px_rgba(0,0,0,0.8)]">
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2">
            <span class="grid size-7 place-items-center rounded-lg bg-ink"><WindowMark size={13} ink="#f5f6f8" accent="#d08cbb" /></span>
            <span class="text-[13px] font-semibold">Kiilto Siivous Oy</span>
          </span>
          <span class="flex items-center gap-2 text-[12px] text-ink-soft">
            <span class="hidden sm:inline">Vastaanotan varauksia</span>
            <span class="relative h-[18px] w-[30px] rounded-full bg-plum">
              <span class="absolute top-[2px] right-[2px] size-[14px] rounded-full bg-white shadow-sm"></span>
            </span>
          </span>
        </div>

        <p class="mt-4 mb-2 text-[11.5px] font-medium text-muted">Tulevat varaukset · viikko 48</p>
        <ul class="flex flex-col gap-2">
          {
            bookings.map((b) => (
              <li class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-[0_0_0_1px_var(--color-line)]">
                <span class="flex w-[58px] shrink-0 flex-col leading-tight">
                  <span class="text-[11px] text-muted">{b.day}</span>
                  <span class="font-mono text-[13px]">{b.time}</span>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[13px] font-medium">{b.what}</span>
                  <span class="block text-[11.5px] text-muted">{b.where}</span>
                </span>
                <Check size={14} weight="bold" className="text-plum" />
              </li>
            ))
          }
          <li
            class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-[0_0_0_1.5px_var(--color-plum),0_0_0_5px_rgba(122,74,110,0.12)]"
            data-detail
          >
            <span class="flex w-[58px] shrink-0 flex-col leading-tight">
              <span class="text-[11px] text-muted">Pe 28.11.</span>
              <span class="font-mono text-[13px]">09.00</span>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-[13px] font-semibold">Uusi varaus · Airbnb</span>
              <span class="block text-[11.5px] text-muted">Punavuori</span>
            </span>
            <span class="rounded-full bg-plum px-2.5 py-1 text-[11.5px] font-medium text-white">Hyväksy</span>
          </li>
        </ul>

        <div class="mt-3 flex items-center justify-between rounded-xl bg-mist-soft px-3 py-2.5 text-[12px]" data-detail style="--d:1">
          <span class="text-ink-soft">Seuraava tilitys</span>
          <span class="font-medium text-ink">pe 28.11.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/reveal'
</script>
